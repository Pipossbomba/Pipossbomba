# ============================================================
# FICHEIRO DE EXEMPLO — copia para .env e preenche os valores
# NUNCA faças commit do ficheiro .env!
# ============================================================

# Chave privada da tua carteira Solana (formato base58 — Phantom/Solflare)
# ATENÇÃO: Guarda este valor em local seguro. Nunca partilhes com ninguém!
SOLANA_PRIVATE_KEY=a_tua_chave_privada_base58_aqui

# Chave pública da carteira (não é secreta)
WALLET_PUBLIC_KEY=a_tua_chave_publica_base58_aqui

# URL RPC Solana
# Recomendado para produção: usar RPC privado (Helius, QuickNode, Triton)
# RPC público (gratuito mas com limites de taxa):
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Exemplo com Helius (mais rápido e fiável):
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=A_TUA_API_KEY

# Token do Bot Telegram (obtido via @BotFather no Telegram)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ID do teu chat pessoal no Telegram (obtido via @userinfobot)
TELEGRAM_CHAT_ID=123456789

# Chave secreta para autenticar os webhooks do TradingView
# Usa uma string longa e aleatória — ex: openssl rand -hex 32
WEBHOOK_SECRET=a_tua_chave_secreta_webhook_muito_longa_e_aleatoria

# ── Parâmetros de risco (opcional — sobrepõe os padrões de 4_config.py) ──
# MIN_SIGNAL_STRENGTH=2
# RISK_PER_TRADE_PCT=2.0
# MIN_TRADE_SOL=0.05
# MAX_TRADE_SOL=1.0
# MAX_DAILY_LOSS_USD=20.0
# COOLDOWN_MINUTES=15
# SLIPPAGE_BPS=50
# PRIORITY_FEE=1000

# Muda para False apenas quando estiveres PRONTO para trading real!
# DRY_RUN=True
